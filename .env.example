# Server
NODE_ENV=development     # Valores: "development" || "production". Cambiar a "production" deshabilita el seeder.
PORT=3000

# Links
ADMIN_PANEL_URL=http://localhost:5173       # Front-end panel de administración

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app_db

# JWT admins. Ambos distintos entre sí.
JWT_ADMIN_ACCESS_SECRET=cambia_este_secret_admin_acceso
JWT_ADMIN_REFRESH_SECRET=cambia_este_secret_admin_refresco
JWT_ADMIN_ACCESS_EXPIRES_IN=15m
JWT_ADMIN_REFRESH_EXPIRES_IN=1d

# TOTP
TOTP_ENCRYPTION_KEY=genera_una_clave_hex_de_64_caracteres  # Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Seeder
ADMIN_USERNAME_SEEDER=admin
ADMIN_PASSWORD_SEEDER=cambia_esta_password_min_8_caracteres

# Documentación (Swagger)
SWAGGER_USER=admin
SWAGGER_PASSWORD=cambia_esta_password_swagger

# Redis (usado para pending 2FA challenges)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esta_password_redis

# TTL del challenge de 2FA pendiente en milisegundos (default: 180000 = 3 minutos)
PENDING_2FA_TTL_MS=180000

# Máximo de intentos fallidos de TOTP antes de invalidar el challenge
PENDING_2FA_MAX_ATTEMPTS=5